{
  "name": "gaba-backend",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for promo codes (PromoCode + PromoCodeActivation)",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --debug",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "clean:all": "rm -rf dist node_modules package-lock.json pnpm-lock.yaml src/generated",
    "docker:up": "docker compose -p gaba -f docker/docker-compose.yaml up -d",
    "docker:down": "docker compose -p gaba -f docker/docker-compose.yaml down -v",
    "docker:down:all": "docker compose -p gaba -f docker/docker-compose.yaml down -v --rmi all",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-express": "^11.1.17",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "dotenv": "^17.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "prisma": "^7.6.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0"
  }
}
